{
  "name": "Dotrino Chat",
  "short_name": "Chat",
  "description": "Chat en tiempo real con salas públicas y mensajes directos.",
  "start_url": "./",
  "scope": "./",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121212",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
